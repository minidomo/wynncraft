{
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",
		"lib": ["ES2025"],
		"types": ["node"],
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	}
}
